              <xs:minInclusive value="1950"/>
              <xs:maxInclusive value="2026"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="R-01: Lagertyp muss zur Lagerart (PredefinedType ELASTOMERIC) passen. Erlaubt ist nur «Elastomer» (Begriff nach ASB-ING). «Topf» oder «Kalotte» an einem Elastomerlager ist ein Widerspruch.">
          <ids:propertySet>
            <ids:simpleValue>BFH_Minor</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Lieferant</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="R-01: Lagertyp muss zur Lagerart (PredefinedType ELASTOMERIC) passen. Erlaubt ist nur «Elastomer» (Begriff nach ASB-ING). «Topf» oder «Kalotte» an einem Elastomerlager ist ein Widerspruch.">
          <ids:propertySet>
            <ids:simpleValue>BFH_Minor</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Modell</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="R-01/R-02 Elastomerlager: Lagertyp und Einbaujahr" ifcVersion="IFC4X3_ADD2" description="Jedes Kalottenlager hat einen Lagertyp der zur Lagerart passt, einen Lieferanten, ein Modellname und ein plausibles Einbaujahr." identifier="R-01_R-02" instructions="Lieferant: Projektverfasser:in (Modellautor ING). Prüfung: BIM-Koordination. Empfänger: Erhaltungsmanagement.">
