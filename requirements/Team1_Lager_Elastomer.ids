<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>R-01/R-02 Elastomerlager: Lagertyp und Einbaujahr</ids:title>
    <ids:description>Jedes Elastomerlager hat einen Lagertyp der zur Lagerart passt, einen Lieferanten, ein Modellname und ein plausibles Einbaujahr.</ids:description>
  </ids:info>
  <ids:specifications>
    <ids:specification name="R-01/R-02 Elastomerlager: Lagertyp und Einbaujahr" ifcVersion="IFC4X3_ADD2" description="Jedes Elastomerlager hat einen Lagertyp der zur Lagerart passt, einen Lieferanten, ein Modellname und ein plausibles Einbaujahr." identifier="R-01_R-02" instructions="Lieferant: Projektverfasser:in (Modellautor ING). Prüfung: BIM-Koordination. Empfänger: Erhaltungsmanagement.">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBEARING</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>ELASTOMERIC</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="R-01: Lagertyp muss zur Lagerart (PredefinedType ELASTOMERIC) passen. Erlaubt ist nur «Elastomer» (Begriff nach ASB-ING). «Topf» oder «Kalotte» an einem Elastomerlager ist ein Widerspruch.">
          <ids:propertySet>
            <ids:simpleValue>BFH_Minor</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Lagertyp</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>Elastomer</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCINTEGER" cardinality="required" instructions="R-02: Einbaujahr als ganze Zahl (JJJJ), zwischen 1950 und 2026 (nicht in der Zukunft). Grundlage für Nutzungsdauer und Ersatzzeitpunkt.">
          <ids:propertySet>
            <ids:simpleValue>BFH_Minor</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Einbaujahr</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:minInclusive value="1950"/>
              <xs:maxInclusive value="2026"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="R-01: Lagertyp muss zur Lagerart (PredefinedType ELASTOMERIC) passen. Erlaubt ist nur «Elastomer» (Begriff nach ASB-ING). «Topf» oder «Kalotte» an einem Elastomerlager ist ein Widerspruch.">
          <ids:propertySet>
            <ids:simpleValue>BFH_Minor</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Lieferant</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="R-01: Lagertyp muss zur Lagerart (PredefinedType ELASTOMERIC) passen. Erlaubt ist nur «Elastomer» (Begriff nach ASB-ING). «Topf» oder «Kalotte» an einem Elastomerlager ist ein Widerspruch.">
          <ids:propertySet>
            <ids:simpleValue>BFH_Minor</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Modell</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="R-03 Brücke: Baujahr" ifcVersion="IFC4X3_ADD2" description="Die Brücke hat ein Baujahr." identifier="R-03" instructions="Lieferant: Projektverfasser:in. Empfänger: Erhaltungsmanagement (Stammdaten).">
      <ids:applicability>
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBRIDGE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCINTEGER" cardinality="required" instructions="R-03: Baujahr als ganze Zahl (JJJJ), zwischen 1850 und 2026.">
          <ids:propertySet>
            <ids:simpleValue>CH_Bauwerksdaten</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Baujahr</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:minInclusive value="1850"/>
              <xs:maxInclusive value="2026"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="R-01/R-02 Elastomerlager: Lagertyp und Einbaujahr" ifcVersion="IFC4X3_ADD2" description="Jedes Topflager hat einen Lagertyp der zur Lagerart passt, einen Lieferanten, ein Modellname und ein plausibles Einbaujahr." identifier="R-01_R-02" instructions="Lieferant: Projektverfasser:in (Modellautor ING). Prüfung: BIM-Koordination. Empfänger: Erhaltungsmanagement.">
